# Track only source/configuration files under bin/, deps/, TeX/, and Docs,
# plus the top-level project files below. Everything else here is Jarvis-HEP
# run state, generated output, or local tool configuration.

# Ignore everything at the top level...
/*

# ...except the source folders (and everything inside them)
!/bin/
!/deps/
!/TeX/
!/Docs/

# ...and these top-level project files
!/README.md
!/.gitignore
!/jarvis.project.yaml
!/.jarvis-project.json

# OS / editor files
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Jarvis runtime state and generated artifacts, explicit even though /*
# already catches these at the project root.
/.claude/
/.obsidian/
/.jarvis/
/.jarvis-pack/
/.cache/
/calculators/
/checkpoints/
/images/
/logs/
/outputs/
/reports/
/exports/
/tmp/

# Python and notebook caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environments and temporary working files
.venv/
venv/
tmp_check/
*.local

# Dependency-local build/cache products; keep source files under deps/ trackable.
deps/**/__pycache__/
deps/**/.cache/
deps/**/build/
deps/**/dist/

# LaTeX build artifacts under TeX/ (compiled PDFs are kept tracked)
TeX/.texpadtmp/
TeX/**/*.aux
TeX/**/*.log
TeX/**/*.bbl
TeX/**/*.blg
TeX/**/*.synctex.gz
TeX/**/*.out
TeX/**/*.fls
TeX/**/*.fdb_latexmk
TeX/**/*.toc
TeX/**/*.bcf
TeX/**/*.run.xml
TeX/**/*.nav
TeX/**/*.snm
TeX/**/*.vrb
TeX/**/*.xdv
